# ==================================================
# REXTON WATCHES - HOSTINGER PRODUCTION ENVIRONMENT
# ==================================================

# Database (Hostinger Managed MySQL or Local MySQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://rexton_user:rexton_secure_pass@127.0.0.1:3306/rexton_db"

# Application URL
NEXT_PUBLIC_APP_URL="https://rexton.com"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
NEXT_PUBLIC_CURRENCY_CODE="INR"

# Authentication
# Generate with: openssl rand -base64 32
AUTH_SECRET="rexton_super_secret_jwt_key_2026_luxury_timepieces_production"
AUTH_COOKIE_NAME="rexton_session"

# Razorpay Payment Gateway (Test or Live keys from Razorpay Dashboard)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_key"

# Cloudinary (Image storage and dynamic responsive optimization)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="rexton-watches"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret_here"

# SMTP Email Configuration (Hostinger Titan Mail, Google Workspace, or Resend SMTP)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="concierge@rexton.com"
SMTP_PASSWORD="your_smtp_password"
EMAIL_FROM="REXTON Concierge <concierge@rexton.com>"
ADMIN_EMAIL="admin@rexton.com"

# Next.js Build Option for Hostinger (Set to 'standalone' or 'standard')
NEXT_OUTPUT_STANDALONE="false"
